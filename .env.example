# ─────────────────────────────────────────────────────────────────────────────
# AEGIS - environment template.  Copy to .env and fill in.
# Every value below is a placeholder.  No real secret is ever committed (I11).
# ─────────────────────────────────────────────────────────────────────────────

SERVICE_NAME=aegis-api
LOG_LEVEL=INFO
LOG_TO_KAFKA=true
# Where the rotating log files go.  Must be writable by the running user.
LOG_DIR=logs
DEMO_MODE=true
ENVIRONMENT=development

# ── Datastores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aegis:aegis@postgres:5432/aegis
DATABASE_URL_SYNC=postgresql+psycopg://aegis:aegis@postgres:5432/aegis
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ENABLED=true

# ── Object storage for evidence artifacts ───────────────────────────────────
OBJECT_STORE=local
LOCAL_STORE_PATH=/data/evidence
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false

# ── Email (development provider writes to Mailpit; no external service) ─────
EMAIL_PROVIDER=development
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=aegis@localhost

# ── Payment rail ────────────────────────────────────────────────────────────
# PAYMENT_RAIL=simulated  -> deterministic local adapter, labelled SIMULATED in the UI
# PAYMENT_RAIL=razorpay   -> Razorpay TEST MODE only.  Never production keys.
PAYMENT_RAIL=simulated
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=PLACEHOLDER_TEST_MODE_SECRET
RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER_TEST_MODE_WEBHOOK_SECRET
RAZORPAY_ROUTE_SELLER_ACCOUNT=

# ── AI provider ─────────────────────────────────────────────────────────────
# AI_PROVIDER=anthropic | groq | fixture
#   anthropic -> claude-opus-5 / claude-sonnet-5 via the Anthropic SDK
#   groq      -> OpenAI-compatible Groq chat-completions endpoint
#   fixture   -> deterministic offline adapter (no network, no key).
#                Eval reports state the provider that produced every number.
AI_PROVIDER=fixture
AI_API_KEY=
AI_MODEL_VERIFIER=claude-opus-5
AI_MODEL_ARBITER=claude-opus-5
AI_MODEL_EXTRACTION=claude-sonnet-5
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_VERIFIER=llama-3.3-70b-versatile
GROQ_MODEL_ARBITER=llama-3.3-70b-versatile
GROQ_MODEL_EXTRACTION=llama-3.3-70b-versatile

# ── Blockchain (Base Sepolia testnet) ───────────────────────────────────────
CHAIN_ENABLED=true
BLOCKCHAIN_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
CONTRACT_ADDRESS=
OPERATOR_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=

# ── Demo users (seeded verified; passwords never hardcoded in the repo) ─────
DEMO_BUYER_EMAIL=owner@meridian.demo
DEMO_SELLER_EMAIL=owner@tirupur.demo
DEMO_BUYER_PASSWORD=CHANGE_ME_demo_password
DEMO_SELLER_PASSWORD=CHANGE_ME_demo_password

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_CHAIN_EXPLORER=https://sepolia.basescan.org
NEXT_PUBLIC_CHAIN_ID=84532
