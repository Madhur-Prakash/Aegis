# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
htmlcov/
.coverage

# Runtime logs (logifyx writes one file per logger)
backend/logs/
logs/

# Node
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# Env & secrets.  `.env.*` rather than `.env.local` alone: Next and Compose both
# read `.env.production` / `.env.development`, and those hold the same kind of
# value as `.env`.  `.env.example` is the one that is meant to be committed.
.env
.env.*
!.env.example
*.pem
*.key

# Generated data (regenerate with `make dataset`)
data/generated/
backend/evals/out/
backend/data/

# Reference recordings (motion references, never committed)
*.mp4
*.mov

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
# Foundry dependencies land here.  `forge-std` is a declared submodule that the
# contracts import directly (forge-std/Test.sol, Script.sol, console2.sol), so it
# is tracked as a one-line gitlink -- not ignored, and not 1.3 MB of vendored
# files.  Anything else `forge install` drops in stays out of the repo.
contracts/lib/*
!contracts/lib/forge-std

# OS
.DS_Store
Thumbs.db

# Verification cookie jar (make verify-login)
backend/.verify-cookies

# Rendered product videos (large binaries; regenerate with videos/make.js)
videos/
